{
  "language": "Python 3.11+ (stdlib), SQLite, HTML/CSS and native JavaScript ES modules",
  "project_shape": "fullstack",
  "source_extensions": [
    ".py",
    ".js",
    ".css",
    ".html",
    ".sql"
  ],
  "build_command": "python3 -B -c \"from pathlib import Path; [compile(p.read_bytes(),str(p),'exec') for p in Path('.').glob('*/*.py')]\"",
  "testing": "deferred",
  "workflow_checks": [
    {
      "workflow_id": "reference-votes",
      "command": "python3 -B -m tree.example /chronology/reference-votes"
    },
    {
      "workflow_id": "candidate-offsets",
      "command": "python3 -B -m tree.example /chronology/candidate-offsets"
    },
    {
