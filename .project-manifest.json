  "complexity": {
    "mechanisms": [
      "宽度为正整数微米；`null` 是缺测，不会跨两侧计算升降。升降归属于后一年。",
      "共识先满足最小票数，再要求单一票数最高的方向；零差是正常一票。",
      "排序先比有效转折的精确匹配率，再比有效对数；仍并列时保留所有候选。拟合起年唯一时原缺测仍输出 null。",
      "按发布代次进行事务更新",
      "保留原始输入与规范化版本",
      "原子批加工",
      "固定修订复算",
      "导出前校验证据摘要"
    ]
  }
